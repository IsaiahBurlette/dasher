# Optional: enables "Sign in with Google" + cross-device cloud sync.
# Without these, the app works exactly as before, storing data only in
# this browser's localStorage. See README.md "Cloud sync setup" for how
# to get these values from your own free Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
