rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
// Each signed-in user can only read/write their own data: their dash entries
// (users/{their uid}/entries/{entryId}) and their own user doc, which holds
// settings like the weekly goal (users/{their uid}).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
